---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

// Source canonique du chantier : src/data/saga.js (partagée avec /, /saga et /tomes)
import { CYCLES, TOMES, statutLabel, DATE_MAJ, CHAPITRES_ECRITS } from "../data/saga.js";

// Les pastilles de chaque cycle sont déduites de la liste des tomes.
const cycles = CYCLES.map((c) => ({
  ...c,
  pastilles: TOMES.filter((t) => t.cycle === c.titre).map((t) => ({
    roman: t.num,
    label: t.statut === "a-ecrire" ? statutLabel[t.statut]
         : `${t.titre} — ${statutLabel[t.statut].toLowerCase()}${t.parution ? ` en ${t.parution}` : ""}`,
    statut: t.statut,
  })),
}));

const compte = (...statuts) => TOMES.filter((t) => statuts.includes(t.statut)).length;
const stats = [
  { num: compte("disponible"), label: "parus" },
  { num: compte("a-paraitre"), label: "à paraître" },
  { num: compte("retouches"), label: "en retouches" },
  { num: CHAPITRES_ECRITS, label: "chapitres écrits" },
];

const dateMaj = DATE_MAJ;
---

<BaseLayout
  title="Le chantier — Le Prix du Nom"
  description="État d'avancement de la saga Le Prix du Nom : six cycles, onze tomes écrits, le douzième en cours. Mise à jour publique du chantier d'écriture."
  current="/chantier"
>
  <PageHeader
    surtitre="État d'avancement"
    titre="Le chantier"
    accroche="Six cycles. Onze tomes écrits, trois parus, le quatrième à paraître en février 2027, le douzième s'écrit — et deux cycles restent à mener jusqu'au bout. Mise à jour publique, en toute transparence."
  />

  <section class="stats">
    {stats.map((s) => (
      <div class="stat-card">
        <div class="stat-num">{s.num}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </section>

  <section class="chantier-detail">
    <div class="maj">Dernière mise à jour : {dateMaj}</div>
    <div class="chantier-list">
      {cycles.map((cycle) => (
        <div class="cycle-block">
          <div class="cycle-header">
            <div class="cycle-num">{cycle.num}</div>
            <div class="cycle-title">
              <h2>{cycle.titre}</h2>
              <div class="periode">{cycle.periode} · {cycle.accroche.toLowerCase()}</div>
            </div>
            <div class="cycle-count">{cycle.count}</div>
          </div>
          <div class="tomes-pastilles">
            {cycle.pastilles.map((t) => (
              <span class={`tome-pastille ${t.statut}`}>
                <span class="dot"></span>
                <span class="roman">{t.roman}</span> {t.label}
              </span>
            ))}
            {cycle.reste && (
              <span class="tome-pastille a-ecrire">
                <span class="dot"></span>
                {cycle.reste}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="legende">
      <span><span class="dot" style="background: var(--sang); box-shadow: 0 0 8px var(--sang);"></span>Disponible</span>
      <span><span class="dot" style="background: #8BB58B;"></span>À paraître</span>
      <span><span class="dot" style="background: var(--or);"></span>En retouches</span>
      <span><span class="dot" style="background: rgba(168, 139, 92, 0.4);"></span>En cours d'écriture</span>
    </div>
  </section>
</BaseLayout>

<style>
  .stats {
    padding: 3rem 2rem;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .stat-card {
    text-align: center;
    padding: 2rem 1rem;
    background: var(--ivoire-fonce);
    border-top: 2px solid var(--or);
  }
  .stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5rem;
    color: var(--sang);
    line-height: 1;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }
  .stat-label {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--encre-doux);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .chantier-detail {
    padding: 3rem 2rem 5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .maj {
    text-align: center;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--or);
    margin-bottom: 2rem;
  }

  .cycle-block {
    padding: 2rem 0;
    border-bottom: 1px solid var(--filet);
  }
  .cycle-block:last-child { border-bottom: none; }
  .cycle-header {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 2rem;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }
  .cycle-count {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--or);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cycle-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3rem;
    color: var(--or);
    line-height: 1;
    font-weight: 400;
    text-align: center;
  }
  .cycle-title h2 {
    font-size: 1.8rem;
    margin-bottom: 0.2rem;
    color: var(--encre);
    font-weight: 500;
  }
  .cycle-title .periode {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--encre-doux);
    font-size: 1rem;
  }
  .tomes-pastilles {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-left: 112px;
  }
  .tome-pastille {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--filet);
    border-radius: 30px;
    font-size: 0.95rem;
    color: var(--encre-doux);
    background: var(--ivoire);
  }
  .tome-pastille .roman {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    color: var(--or);
  }
  .tome-pastille .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .tome-pastille.disponible {
    border-color: var(--sang);
    background: rgba(122, 46, 31, 0.06);
    color: var(--encre);
  }
  .tome-pastille.disponible .dot {
    background: var(--sang);
    box-shadow: 0 0 8px var(--sang);
  }
  .tome-pastille.disponible .roman { color: var(--sang); }
  .tome-pastille.a-paraitre { border-color: #8BB58B; }
  .tome-pastille.a-paraitre .dot { background: #8BB58B; }
  .tome-pastille.retouches .dot { background: var(--or); }
  .tome-pastille.a-ecrire { opacity: 0.6; }
  .tome-pastille.a-ecrire .dot { background: rgba(168, 139, 92, 0.4); }

  .legende {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--filet);
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--encre-doux);
  }
  .legende > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .legende .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  @media (max-width: 860px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .cycle-header { grid-template-columns: 60px 1fr; gap: 1rem; }
    .cycle-count { grid-column: 1 / -1; padding-left: 70px; }
    .cycle-num { font-size: 2.2rem; }
    .cycle-title h2 { font-size: 1.4rem; }
    .tomes-pastilles { padding-left: 0; }
  }
</style>

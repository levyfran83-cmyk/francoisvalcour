---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";

import { ACHAT } from "../../data/achat.js";
import { TOMES, statutLabel, NB_PARUS, DATE_MAJ, enLettres } from "../../data/saga.js";

// Les tomes, leurs statuts et leurs cycles vivent dans src/data/saga.js.
const tomes = TOMES.map((t) => ({ ...t, achat: t.achat ? ACHAT[t.achat] : null }));
---

<BaseLayout
  title="Les tomes — Le Prix du Nom"
  description="Les tomes de la saga Le Prix du Nom, organisés en six cycles : L'Ascension, La Chute, La Restauration, L'Établissement, La Relève, Le Nom hérité."
  current="/tomes"
>
  <PageHeader
    surtitre="L'œuvre, tome par tome"
    titre="Les tomes"
    accroche={`Quatre-vingts ans d'histoire de France en six cycles. Onze tomes sont écrits, ${enLettres(NB_PARUS)} sont parus, le douzième s'écrit. État du chantier au ${DATE_MAJ}.`}
  />

  <section class="tomes-grid">
    {tomes.map((t) => (
      <article class={`tome-card statut-${t.statut}`}>
        <div class="tome-roman">
          <span class="chiffre">{t.num}</span>
          {t.couverture && (
            <img src={t.couverture} alt={`Couverture du tome ${t.num} — ${t.titre}`} width={t.dim[0]} height={t.dim[1]} loading="lazy" />
          )}
        </div>
        <div class="tome-content">
          <div class="tome-cycle">Cycle · {t.cycle}</div>
          <h2>{t.titre}</h2>
          <div class="tome-periode">{t.periode}</div>
          <p>{t.resume}</p>
          <div class="tome-footer">
            <span class={`statut-badge ${t.statut}`}>{statutLabel[t.statut]}</span>
            <div class="tome-actions">
              {t.achat && (
                <>
                  <a href={t.achat.broche} class="tome-achat" target="_blank" rel="noopener">Broché · {t.achat.prixBroche}</a>
                  <a href={t.achat.kindle} class="tome-achat tome-achat-kindle" target="_blank" rel="noopener">Kindle · {t.achat.prixKindle}</a>
                </>
              )}
              {t.href && <a href={t.href} class="tome-link">En savoir plus →</a>}
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .tomes-grid {
    padding: 4rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .tome-card {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 2rem;
    padding: 2rem 2.5rem;
    background: var(--ivoire);
    border: 1px solid var(--filet);
    border-left: 4px solid var(--or);
    transition: all 0.3s;
  }
  .tome-card:hover {
    border-left-color: var(--sang);
    box-shadow: 0 15px 35px -15px rgba(28, 28, 26, 0.15);
    transform: translateY(-2px);
  }
  .tome-card.statut-disponible { border-left-color: var(--sang); background: rgba(122, 46, 31, 0.04); }
  .tome-card.statut-a-paraitre { border-left-color: #8BB58B; }
  .tome-card.statut-a-ecrire { opacity: 0.7; border-left-color: rgba(168, 139, 92, 0.3); }
  .tome-card.statut-a-ecrire:hover { opacity: 1; }

  .tome-roman {
    text-align: center;
    align-self: center;
  }
  .tome-roman .chiffre {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 4rem;
    line-height: 1;
    color: var(--or);
    font-weight: 400;
  }
  .tome-roman img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 0.9rem;
    border: 1px solid var(--or);
    box-shadow: 0 10px 22px -10px rgba(0, 0, 0, 0.45);
  }
  .tome-card.statut-disponible .tome-roman .chiffre { color: var(--sang); }

  .tome-cycle {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--or);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .tome-content h2 {
    font-size: 1.9rem;
    margin-bottom: 0.3rem;
    color: var(--encre);
    font-weight: 500;
  }
  .tome-card.statut-a-ecrire h2,
  .tome-card.statut-retouches h2 { color: var(--encre-doux); }
  .tome-periode {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--encre-doux);
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  .tome-content p {
    color: var(--encre-doux);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  .tome-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .statut-badge {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 30px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid;
  }
  .statut-badge.disponible { background: var(--sang); color: var(--ivoire); border-color: var(--sang); }
  .statut-badge.a-paraitre { background: #E8F0E5; color: #3F6B3A; border-color: #8BB58B; }
  .statut-badge.retouches { background: rgba(168, 139, 92, 0.1); color: var(--or); border-color: var(--or); }
  .statut-badge.a-ecrire { background: transparent; color: var(--encre-doux); border-color: var(--filet); }

  .tome-actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .tome-achat {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    background: var(--sang);
    color: var(--ivoire);
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    border: 1px solid var(--sang);
    transition: all 0.25s;
  }
  .tome-achat:hover { background: var(--encre); border-color: var(--encre); color: var(--ivoire); }
  .tome-achat-kindle {
    background: transparent;
    color: var(--sang);
  }
  .tome-achat-kindle:hover { background: var(--sang); color: var(--ivoire); }
  .tome-link {
    font-style: italic;
    font-size: 0.95rem;
    color: var(--sang);
  }

  @media (max-width: 860px) {
    .tome-card {
      grid-template-columns: 80px 1fr;
      gap: 1rem;
      padding: 1.5rem;
    }
    .tome-roman .chiffre { font-size: 2.8rem; }
    .tome-content h2 { font-size: 1.5rem; }
  }
</style>

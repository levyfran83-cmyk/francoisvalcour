---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";

import { ACHAT } from "../../data/achat.js";

// Liste des 12 tomes. Les statuts sont source de vérité unique :
//   "disponible": Tomes I et II — parus, en vente sur Amazon (broché + Kindle)
//   "retouches" : Tomes III à XI — écrits, en révision avant parution
//   "a-ecrire"  : Tome XII — en cours d'écriture
// Périodes et titres relevés sur les manuscrits eux-mêmes (13 août 2026).
const tomes = [
  { num: "I",    titre: "La Ruelle",  periode: "1793 — 1804", cycle: "L'Ascension",       statut: "disponible", href: "/tomes/la-ruelle", achat: ACHAT.I,
    resume: "Sarah de La Roche-Aymon, Julian Moreau, et la naissance d'une maison sous la Révolution, le Consulat et l'Empire naissant." },
  { num: "II",   titre: "Le Maréchal", periode: "1804 — 1807", cycle: "L'Ascension",      statut: "disponible", href: "/tomes/le-marechal", achat: ACHAT.II,
    resume: "1804. L'Empire se couronne. Bataille après bataille — Austerlitz, Iéna, Eylau —, Julian gagne le droit d'exister, jusqu'au bâton de maréchal. Mais la gloire menace le secret que Sarah protège seule." },
  { num: "III",  titre: "Le Zénith", periode: "1807 — 1809", cycle: "L'Ascension",    statut: "retouches", href: null,
    resume: "L'Empire à son plus haut. Le nouveau régime, le pli de Bayonne, l'Espagne qui s'ouvre — et une maison qui apprend à tenir son rang sans se faire voir." },
  { num: "IV",   titre: "Le Roi de Rome", periode: "1809 — 1811", cycle: "L'Ascension",    statut: "retouches", href: null,
    resume: "Le divorce, le mariage autrichien, la naissance de l'héritier. La cour se refait, les places changent de mains, et la fortune des Moreau se met à l'abri." },
  { num: "V",    titre: "Le Niémen", periode: "1812 — 1814", cycle: "La Chute",       statut: "retouches", href: null,
    resume: "Le fleuve qu'on passe deux fois. Borodino, Moscou, la Bérézina, le vingt-neuvième bulletin — puis l'Allemagne, Leipzig, et la campagne de France jusqu'à Saint-Cloud." },
  { num: "VI",   titre: "La Place", periode: "1814", cycle: "La Chute",       statut: "retouches", href: null,
    resume: "Les Cosaques rue du Bac, la Charte, la première Restauration. Ce qu'on perd, ce qu'on reprend, et la place qu'on tient sans la revendiquer." },
  { num: "VII",  titre: "Les Greniers", periode: "1814 — 1818", cycle: "La Restauration", statut: "retouches", href: null,
    resume: "Les Cent-Jours, puis l'année sans été : la récolte qui ne vient pas, les greniers qu'on ouvre, la soudure d'un hiver. C'est en nourrissant qu'une maison s'enracine." },
  { num: "VIII", titre: "Les Sablons", periode: "1818 — 1824", cycle: "La Restauration", statut: "retouches", href: null,
    resume: "Henri entre aux Ponts, le domaine devient une industrie, un fils se marie. Le nom cesse d'être une dette pour devenir un capital." },
  { num: "IX",   titre: "Le Nom rendu", periode: "1825 — 1835", cycle: "La Restauration", statut: "retouches",  href: null,
    resume: "Le sacre de Charles X, le choléra, les Trois Glorieuses. La deuxième génération prend la maison en main, et le nom qu'on avait payé se voit enfin rendu." },
  { num: "X",    titre: "Les Feux de Noirlac", periode: "1835 — 1840", cycle: "L'Établissement", statut: "retouches",  href: null,
    resume: "L'acier, les maisons de banque, le fer français contre la barre anglaise. Sous la monarchie de Juillet, une famille apprend le siècle des machines." },
  { num: "XI",   titre: "La Ligne", periode: "1840 — 1847", cycle: "L'Établissement", statut: "retouches", href: null,
    resume: "Le retour des cendres, le rail qu'on pose, la ligne qu'on trace. Trois sens d'un même mot : la voie ferrée, la ligne d'un registre, et la lignée." },
  { num: "XII",  titre: "(en cours d'écriture)",  periode: "1848 — 1870", cycle: "Le Second Empire", statut: "a-ecrire", href: null,
    resume: "La Deuxième République, le coup d'État, le Second Empire dans ses fastes — jusqu'à Sedan, et la dernière fois où un Moreau paiera le prix du nom." },
];

const statutLabel = {
  disponible:"Disponible",
  finalise:  "En cours de finalisation",
  retouches: "En retouches",
  "a-ecrire":"À écrire",
};
---

<BaseLayout
  title="Les tomes — Le Prix du Nom"
  description="Les douze tomes de la saga Le Prix du Nom, organisés en quatre cycles : L'Ascension, La Chute, La Restauration, Le Second Empire."
  current="/tomes"
>
  <PageHeader
    surtitre="L'œuvre, tome par tome"
    titre="Les douze tomes"
    accroche="Douze volumes, quatre-vingts ans d'histoire de France. Onze sont écrits ; deux sont parus. État du chantier au 13 août 2026."
  />

  <section class="tomes-grid">
    {tomes.map((t) => (
      <article class={`tome-card statut-${t.statut}`}>
        <div class="tome-roman">{t.num}</div>
        <div class="tome-content">
          <div class="tome-cycle">Cycle · {t.cycle}</div>
          <h2>{t.titre}</h2>
          <div class="tome-periode">{t.periode}</div>
          <p>{t.resume}</p>
          <div class="tome-footer">
            <span class={`statut-badge ${t.statut}`}>{statutLabel[t.statut]}</span>
            <div class="tome-actions">
              {t.achat && (
                <>
                  <a href={t.achat.broche} class="tome-achat" target="_blank" rel="noopener">Broché · {t.achat.prixBroche}</a>
                  <a href={t.achat.kindle} class="tome-achat tome-achat-kindle" target="_blank" rel="noopener">Kindle · {t.achat.prixKindle}</a>
                </>
              )}
              {t.href && <a href={t.href} class="tome-link">En savoir plus →</a>}
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .tomes-grid {
    padding: 4rem 2rem;
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .tome-card {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 2rem;
    padding: 2rem 2.5rem;
    background: var(--ivoire);
    border: 1px solid var(--filet);
    border-left: 4px solid var(--or);
    transition: all 0.3s;
  }
  .tome-card:hover {
    border-left-color: var(--sang);
    box-shadow: 0 15px 35px -15px rgba(28, 28, 26, 0.15);
    transform: translateY(-2px);
  }
  .tome-card.statut-disponible { border-left-color: var(--sang); background: rgba(122, 46, 31, 0.04); }
  .tome-card.statut-imprime { border-left-color: #8BB58B; }
  .tome-card.statut-a-ecrire { opacity: 0.7; border-left-color: rgba(168, 139, 92, 0.3); }
  .tome-card.statut-a-ecrire:hover { opacity: 1; }

  .tome-roman {
    font-family: 'Cormorant Garamond', serif;
    font-size: 4rem;
    line-height: 1;
    color: var(--or);
    font-weight: 400;
    text-align: center;
    align-self: center;
  }
  .tome-card.statut-disponible .tome-roman { color: var(--sang); }

  .tome-cycle {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--or);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .tome-content h2 {
    font-size: 1.9rem;
    margin-bottom: 0.3rem;
    color: var(--encre);
    font-weight: 500;
  }
  .tome-card.statut-a-ecrire h2,
  .tome-card.statut-retouches h2 { color: var(--encre-doux); }
  .tome-periode {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--encre-doux);
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  .tome-content p {
    color: var(--encre-doux);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  .tome-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .statut-badge {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 30px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid;
  }
  .statut-badge.disponible { background: var(--sang); color: var(--ivoire); border-color: var(--sang); }
  .statut-badge.imprime { background: #E8F0E5; color: #3F6B3A; border-color: #8BB58B; }
  .statut-badge.finalise { background: #E8F0E5; color: #3F6B3A; border-color: #8BB58B; }
  .statut-badge.retouches { background: rgba(168, 139, 92, 0.1); color: var(--or); border-color: var(--or); }
  .statut-badge.a-ecrire { background: transparent; color: var(--encre-doux); border-color: var(--filet); }

  .tome-actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .tome-achat {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    background: var(--sang);
    color: var(--ivoire);
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    border: 1px solid var(--sang);
    transition: all 0.25s;
  }
  .tome-achat:hover { background: var(--encre); border-color: var(--encre); color: var(--ivoire); }
  .tome-achat-kindle {
    background: transparent;
    color: var(--sang);
  }
  .tome-achat-kindle:hover { background: var(--sang); color: var(--ivoire); }
  .tome-link {
    font-style: italic;
    font-size: 0.95rem;
    color: var(--sang);
  }

  @media (max-width: 860px) {
    .tome-card {
      grid-template-columns: 60px 1fr;
      gap: 1rem;
      padding: 1.5rem;
    }
    .tome-roman { font-size: 2.8rem; }
    .tome-content h2 { font-size: 1.5rem; }
  }
</style>

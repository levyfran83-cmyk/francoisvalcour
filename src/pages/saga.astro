---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

import { CYCLES as cycles } from "../data/saga.js";
import { ACHAT } from "../data/achat.js";
---

<BaseLayout
  title="La saga — Le Prix du Nom"
  description="Le Prix du Nom : six cycles, de la Terreur à la fin du Second Empire. Quatre générations de la maison Moreau traversent quatre-vingts ans d'histoire de France."
  current="/saga"
>
  <PageHeader
    surtitre="L'œuvre"
    titre="Une fresque française"
    accroche="Six cycles, quatre générations. De la Terreur aux dernières années du Second Empire, l'histoire de France traversée à hauteur d'homme."
  />

  <section class="intro">
    <p class="intro-p">
      <em>Le Prix du Nom</em> n'est pas une saga d'aventures héroïques. C'est l'histoire d'une
      maison — les Moreau — et de ceux qui l'entourent : les Vernay, les Mareuil, les La
      Roche-Aymon. Quatre familles tissées par les armes, les mariages, les exils.
      Quatre-vingts ans qui voient passer Napoléon, Louis XVIII, Charles X, Louis-Philippe,
      la Deuxième République, le Second Empire. Une seule question, répétée à chaque génération :
    </p>
    <blockquote class="citation-saga">
      « Jusqu'où peut-on s'élever sans payer le prix de ce qu'on porte ? »
    </blockquote>
  </section>

  <section class="cycles">
    {cycles.map((c) => (
      <article class="cycle-card">
        <div class="cycle-marker">
          <div class="cycle-num">{c.num}</div>
          <div class="cycle-periode">{c.periode}</div>
        </div>
        <div class="cycle-body">
          <h2>{c.titre}</h2>
          <div class="cycle-accroche">{c.accroche}</div>
          <p>{c.description}</p>
          <div class="cycle-meta">{c.tomes}</div>
        </div>
      </article>
    ))}
  </section>

  <section class="cta-final">
    <h2>Commencer la lecture</h2>
    <p>
      Le Tome I, <em>La Ruelle</em>, ouvre le premier cycle. Il couvre les années 1793 à 1804
      et est paru aux Éditions du Quai en juin 2026. Les tomes II, <em>Le Maréchal</em>, et III,
      <em>Le Zénith</em>, sont parus depuis — le premier cycle est disponible aux trois quarts.
    </p>
    <div class="cta-bloc">
      <a href={ACHAT.I.broche} class="btn" target="_blank" rel="noopener">Commander le Tome I</a>
      <a href="/tomes" class="btn secondary">Voir tous les tomes</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding: 4rem 2rem 2rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .intro-p {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--encre-doux);
    margin-bottom: 2.5rem;
  }
  .citation-saga {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.6rem;
    color: var(--sang);
    text-align: center;
    padding: 2rem;
    border-top: 1px solid var(--or);
    border-bottom: 1px solid var(--or);
    line-height: 1.5;
  }

  .cycles {
    padding: 3rem 2rem 5rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  .cycle-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 3rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--filet);
  }
  .cycle-card:last-child { border-bottom: none; }
  .cycle-marker {
    text-align: center;
    position: sticky;
    top: 100px;
  }
  .cycle-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 5rem;
    font-weight: 400;
    color: var(--or);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .cycle-periode {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--encre-doux);
    font-size: 1rem;
    letter-spacing: 0.05em;
  }
  .cycle-body h2 {
    font-size: 2.5rem;
    margin-bottom: 0.3rem;
    color: var(--encre);
    font-weight: 500;
  }
  .cycle-accroche {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--sang);
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
  }
  .cycle-body p {
    color: var(--encre-doux);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1.2rem;
  }
  .cycle-meta {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--or);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta-final {
    background: var(--encre);
    color: var(--ivoire);
    padding: 5rem 2rem;
    text-align: center;
  }
  .cta-final h2 {
    color: var(--ivoire);
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }
  .cta-final p {
    color: rgba(245, 241, 232, 0.75);
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }
  .cta-bloc {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-final .btn { background: var(--or); border-color: var(--or); color: var(--encre); }
  .cta-final .btn:hover { background: var(--sang); border-color: var(--sang); color: var(--ivoire); }
  .cta-final .btn.secondary { background: transparent; color: var(--ivoire); border-color: var(--ivoire); }
  .cta-final .btn.secondary:hover { background: var(--ivoire); color: var(--encre); }

  @media (max-width: 860px) {
    .cycle-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      text-align: center;
    }
    .cycle-marker { position: static; }
    .cycle-num { font-size: 3.5rem; }
    .cycle-body h2 { font-size: 2rem; }
  }
</style>
